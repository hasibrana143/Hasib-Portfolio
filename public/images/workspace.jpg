<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="screen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#16a34a" />
      <stop offset="100%" stop-color="#22c55e" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)" />
  
  <!-- Desk -->
  <rect x="50" y="400" width="700" height="40" rx="4" fill="#1c1917" />
  <rect x="80" y="440" width="640" height="8" fill="#292524" />
  
  <!-- Monitor -->
  <rect x="200" y="150" width="400" height="250" rx="8" fill="#1c1917" stroke="#374151" stroke-width="2" />
  <rect x="212" y="162" width="376" height="226" rx="4" fill="url(#screen)" />
  <rect x="220" y="170" width="360" height="200" fill="none" stroke="url(#accent)" stroke-width="1" stroke-dasharray="4,4" opacity="0.3" />
  <text x="400" y="260" font-family="monospace" font-size="14" fill="#16a34a" text-anchor="middle" opacity="0.5">const code = "beautiful";</text>
  <text x="400" y="290" font-family="monospace" font-size="14" fill="#22c55e" text-anchor="middle" opacity="0.5">deploy();</text>
  <text x="400" y="320" font-family="monospace" font-size="14" fill="#4ade80" text-anchor="middle" opacity="0.5">// make it work</text>
  
  <!-- Monitor stand -->
  <rect x="370" y="400" width="60" height="10" rx="2" fill="#374151" />
  <rect x="385" y="410" width="30" height="8" rx="2" fill="#374151" />
  
  <!-- Keyboard -->
  <rect x="300" y="380" width="200" height="16" rx="4" fill="#1c1917" stroke="#374151" stroke-width="1" />
  <g fill="#374151" opacity="0.5">
    <rect x="310" y="384" width="8" height="8" rx="1" />
    <rect x="325" y="384" width="8" height="8" rx="1" />
    <rect x="340" y="384" width="8" height="8" rx="1" />
    <rect x="355" y="384" width="8" height="8" rx="1" />
    <rect x="370" y="384" width="8" height="8" rx="1" />
    <rect x="385" y="384" width="8" height="8" rx="1" />
    <rect x="400" y="384" width="8" height="8" rx="1" />
    <rect x="415" y="384" width="8" height="8" rx="1" />
    <rect x="430" y="384" width="8" height="8" rx="1" />
    <rect x="445" y="384" width="8" height="8" rx="1" />
    <rect x="460" y="384" width="15" height="8" rx="1" />
  </g>
  
  <!-- Plant -->
  <g transform="translate(620, 200)">
    <rect x="-8" y="80" width="16" height="40" rx="4" fill="#43302e" />
    <ellipse cx="0" cy="60" rx="30" ry="25" fill="#15803d" opacity="0.6" />
    <ellipse cx="0" cy="40" rx="25" ry="20" fill="#16a34a" opacity="0.5" />
    <ellipse cx="0" cy="20" rx="20" ry="15" fill="#22c55e" opacity="0.4" />
  </g>
  
  <!-- Coffee mug -->
  <g transform="translate(120, 320)">
    <path d="M0 0 L40 0 L45 40 L-5 40 Z" fill="#1c1917" stroke="#374151" stroke-width="1" />
    <path d="M40 0 L55 15 L55 35 L40 40" fill="#292524" />
    <ellipse cx="20" cy="40" rx="22" ry="3" fill="#292524" />
  </g>
  
  <!-- Decorative forest elements -->
  <g fill="url(#accent)" opacity="0.1">
    <path d="M50 100 L70 60 L90 100 L70 80 Z" />
    <path d="M680 80 L700 40 L720 80 L700 60 Z" />
    <path d="M100 500 L120 460 L140 500 L120 480 Z" />
    <path d="M650 500 L670 460 L690 500 L670 480 Z" />
  </g>
</svg>