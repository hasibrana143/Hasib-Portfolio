<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#030712" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#030712" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#16a34a" />
      <stop offset="100%" stop-color="#22c55e" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)" />
  
  <!-- Decorative forest silhouettes -->
  <g fill="url(#accent)" opacity="0.1">
    <path d="M0 630 L100 450 L150 500 L200 400 L250 480 L300 380 L350 460 L400 350 L450 430 L500 320 L550 410 L600 300 L650 390 L700 280 L750 370 L800 260 L850 350 L900 240 L950 330 L1000 220 L1050 310 L1100 200 L1150 290 L1200 250 L1200 630 Z" />
  </g>
  
  <!-- Main content -->
  <text x="600" y="250" font-family="system-ui, sans-serif" font-size="64" font-weight="800" fill="white" text-anchor="middle" style="text-transform: lowercase;">web design & development</text>
  
  <text x="600" y="330" font-family="system-ui, sans-serif" font-size="24" fill="#94a3b8" text-anchor="middle">Creative Freelance Designer & Developer</text>
  <text x="600" y="360" font-family="system-ui, sans-serif" font-size="20" fill="#64748b" text-anchor="middle">Antwerp, Belgium</text>
  
  <!-- Brand -->
  <text x="600" y="520" font-family="system-ui, sans-serif" font-size="36" font-weight="800" fill="url(#accent)" text-anchor="middle">CodeMaster.</text>
  <text x="600" y="560" font-family="system-ui, sans-serif" font-size="16" fill="#64748b" text-anchor="middle">All rights reserved</text>
</svg>