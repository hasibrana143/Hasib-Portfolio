<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#052e16" />
      <stop offset="100%" stop-color="#14532d" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#22c55e" />
      <stop offset="100%" stop-color="#4ade80" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)" />
  <circle cx="400" cy="250" r="80" fill="url(#accent)" opacity="0.15" />
  <text x="400" y="260" font-family="system-ui, sans-serif" font-size="48" fill="url(#accent)" text-anchor="middle">1</text>
  <text x="400" y="380" font-family="system-ui, sans-serif" font-size="24" font-weight="600" fill="#f8fafc" text-anchor="middle">Understanding</text>
  <text x="400" y="420" font-family="system-ui, sans-serif" font-size="16" fill="#94a3b8" text-anchor="middle">Vision, Goals & Business Dreams</text>
  <g fill="url(#accent)" opacity="0.3">
    <circle cx="200" cy="450" r="40" />
    <circle cx="400" cy="500" r="30" />
    <circle cx="600" cy="460" r="35" />
  </g>
</svg>