<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#312e81" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#a78bfa" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)" />
  <circle cx="400" cy="250" r="80" fill="url(#accent)" opacity="0.15" />
  <text x="400" y="260" font-family="system-ui, sans-serif" font-size="48" fill="url(#accent)" text-anchor="middle">2</text>
  <text x="400" y="380" font-family="system-ui, sans-serif" font-size="24" font-weight="600" fill="#f8fafc" text-anchor="middle">Designing</text>
  <text x="400" y="420" font-family="system-ui, sans-serif" font-size="16" fill="#c4b5fd" text-anchor="middle">Branding, UX/UI & Simplicity</text>
  <g fill="url(#accent)" opacity="0.3">
    <rect x="180" y="430" width="60" height="80" rx="8" />
    <rect x="370" y="460" width="60" height="80" rx="8" />
    <rect x="560" y="440" width="60" height="80" rx="8" />
  </g>
</svg>